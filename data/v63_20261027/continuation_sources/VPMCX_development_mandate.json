{
  "fund_id": "F02",
  "period": "development",
  "verified": true,
  "objective": "Long-term capital appreciation.",
  "mandatory_constraints": [
    {
      "evidence_id": "VPMCX_FOREIGN25",
      "source_document_id": "VPMCX_2025_mandate_prospectus_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 348,
      "text": "Foreign securities, including depositary receipts, are limited to 25% of assets. The source does not explicitly call this denominator NAV.",
      "denominator": "assets (source wording)",
      "handling": "class3_country_security_level",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_DERIVATIVES",
      "source_document_id": "VPMCX_2025_mandate_prospectus_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 351,
      "text": "Limited derivative use may provide alternate issuer or industry exposure; derivatives must not be used for speculation or to leverage investment returns.",
      "denominator": "instrument purpose",
      "handling": "class3_instrument_and_purpose",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_ISSUER25",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4331,
      "text": "At each taxable quarter end, single-issuer holdings are limited to 25% of total assets, excluding U.S. government securities and other regulated investment companies.",
      "denominator": "total assets",
      "handling": "class3_security_level",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_ISSUER75",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4332,
      "text": "For 75% of total assets, purchases may not exceed 10% of one issuer voting securities or result in over 5% of fund total assets in that issuer; U.S. government, agency and instrumentality obligations are excepted.",
      "denominator": "fund total assets and issuer voting securities",
      "handling": "class3_security_level",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_INDUSTRY",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4333,
      "text": "Do not concentrate in issuers whose principal activities share an industry or group of industries. This source classification is not FF12; no numerical FF12 cap is inferred.",
      "denominator": "source-defined industry/group",
      "handling": "class3_source_taxonomy_differs_from_FF12",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_OBJECTIVE_CHANGE",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4335,
      "text": "The investment objective cannot be materially changed without a shareholder vote.",
      "denominator": "governance condition",
      "handling": "class3_conditional",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_BORROWING",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4327,
      "text": "Borrowing is allowed only as permitted by the governing statutes, rules and regulators.",
      "denominator": "transaction attributes",
      "handling": "class3_statutory_instrument_rule",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_BORROWING_COVER",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4394,
      "text": "Maintain continuous asset coverage of 300% of borrowings, measured as total assets including borrowings less liabilities other than borrowings; temporary/emergency borrowing not exceeding 5% of total assets at borrowing has the stated exception.",
      "denominator": "borrowings and total assets",
      "handling": "class3_security_and_path_dependent",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_COMMODITIES",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4329,
      "text": "Commodity investments are allowed only as permitted by the governing statutes, rules and regulators.",
      "denominator": "instrument attributes",
      "handling": "class3_statutory_instrument_rule",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_LOANS",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4336,
      "text": "Loans are allowed only as permitted by the governing statutes, rules and regulators.",
      "denominator": "instrument attributes",
      "handling": "class3_statutory_instrument_rule",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_REAL_ESTATE",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4337,
      "text": "Direct real estate is prohibited except property acquired through ownership of securities or instruments; real-estate-company and real-estate-backed instruments are allowed.",
      "denominator": "instrument attributes",
      "handling": "class3_instrument_rule",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_SENIOR",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4338,
      "text": "Senior securities may be issued only under the stated statutory and regulatory permissions.",
      "denominator": "instrument attributes",
      "handling": "class3_statutory_instrument_rule",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_UNDERWRITING",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4343,
      "text": "Do not underwrite another issuer securities, except being deemed an underwriter in purchases or sales of portfolio securities.",
      "denominator": "transaction attributes",
      "handling": "class3_transaction_rule",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_PURCHASE_TIME",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4344,
      "text": "Percentage restrictions are generally tested on purchase; subsequent market movements alone do not breach a met restriction. Statutory exceptions, including continuous borrowing requirements and explicit quarter-end tests, remain applicable.",
      "denominator": "purchase-time holdings with explicit exceptions",
      "handling": "class3_path_dependent",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_ILLIQUID15",
      "source_document_id": "VPMCX_2025_amendments_web_2_and_liquidity",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4864,
      "text": "Aggregate illiquid investments are limited to 15% of NAV. Illiquid means not reasonably saleable within seven calendar days under current conditions without significantly changing market value.",
      "denominator": "NAV",
      "handling": "class3_security_liquidity",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_LENDING",
      "source_document_id": "VPMCX_2025_amendments_web_2_and_liquidity",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4880,
      "text": "Securities lending is limited to one-third of total assets; permitted collateral must remain at least 100% of loaned securities value, be marked to market, and satisfy termination and income rights.",
      "denominator": "total assets and collateral value",
      "handling": "class3_security_transaction",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_TEMPORARY_DEPARTURE",
      "source_document_id": "VPMCX_2025_mandate_prospectus_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 374,
      "text": "Temporary departures require the advisor to judge them in the fund best interest and consistent with its objective. More favorably priced or needed-liquidity derivatives/ETFs, advisor transitions and large cash flows may justify departures from normal limits; alternate derivative exposure may address issuer/industry limits.",
      "denominator": "conditional portfolio state",
      "handling": "class3_conditional",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_DEFENSIVE",
      "source_document_id": "VPMCX_2025_mandate_prospectus_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 377,
      "text": "Temporary defensive departures may respond to adverse or unusual market, economic, political or other conditions through substantial cash equivalents or less volatile instruments; these positions may fail to achieve the investment objective.",
      "denominator": "conditional portfolio state",
      "handling": "class3_conditional",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_VANGUARD_OWNERSHIP",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4346,
      "text": "The fundamental policies do not prevent the fund from owning Vanguard securities, lending to Vanguard or contributing to its costs or other financial requirements as part owner.",
      "denominator": "ownership-specific exception",
      "handling": "class3_conditional",
      "numerically_enforced_in_FF12": false
    },
    {
      "evidence_id": "VPMCX_BORROWING_RESTORE",
      "source_document_id": "VPMCX_2025_mandate_sai_web_excerpt",
      "source_url": "https://www.sec.gov/Archives/edgar/data/752177/000168386325000459/f40563d0.htm",
      "source_line": 4395,
      "text": "If asset coverage falls below 300%, the fund may be required to sell holdings within three days, excluding Sundays and holidays, to reduce debt and restore coverage despite disadvantageous investment timing.",
      "denominator": "borrowing coverage and elapsed days",
      "handling": "class3_path_dependent",
      "numerically_enforced_in_FF12": false
    }
