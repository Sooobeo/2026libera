</td>
<td valign="top" style="width:25%; "><div style="text-align:right;text-align-last:auto;"><span style="font-family:'Fidelity Centry Std Light Cond';font-size:13px;color:#000000;font-style:normal;font-weight:normal;">&#160;</span><span style="font-family:'Fidelity Futura Std Condensed Light',Arial,Helvetica,sans-serif;font-size:11px;color:#000000;font-style:normal;font-weight:normal;">1,510,512,214</span></div>
</td>
<td valign="top" style="width:25%; "><div style="text-align:right;text-align-last:auto;"><span style="font-family:'Fidelity Centry Std Light Cond';font-size:13px;color:#000000;font-style:normal;font-weight:normal;">&#160;</span><span style="font-family:'Fidelity Futura Std Condensed Light',Arial,Helvetica,sans-serif;font-size:11px;color:#000000;font-style:normal;font-weight:normal;">403,280,574</span></div>
</td>
</tr>
</table>
