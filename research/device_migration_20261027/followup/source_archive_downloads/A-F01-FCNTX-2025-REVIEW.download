</td>
</tr>
<tr><td valign="top" style="width:51%; border-bottom:1px solid #000000;padding:0px 0px 0px 0px;"><div style="text-align:left;text-align-last:auto;"><span style="font-family:'Fidelity Sans';font-size:11px;color:#000000;font-style:normal;font-weight:normal;">Fidelity&#174; Contrafund&#174;</span><span style="font-family:'Fidelity Sans';font-size:11px;color:#000000;font-style:normal;font-weight:normal;">&#160;</span></div>
</td>
<td valign="middle" style="width:21%; border-bottom:1px solid #000000;padding:0px 0px 0px 0px;"><div style="text-align:center;text-align-last:auto;"><span style="font-family:'Fidelity Sans';font-size:11px;color:#000000;font-style:normal;font-weight:normal;">$ </span><ix:nonFraction name="oef:ExpensesPaidAmt" contextRef="C000016601_ClassMember" format="ixt:numdotdecimal" decimals="0" unitRef="usd" id="ixv-89363">82</ix:nonFraction><span style="font-family:'Fidelity Sans';font-size:11px;color:#000000;font-style:normal;font-weight:normal;">&#160;</span></div>
</td>
<td valign="middle" style="width:27%; border-bottom:1px solid #000000;padding:0px 0px 0px 0px;"><div style="text-align:center;text-align-last:auto;"><ix:nonFraction name="oef:ExpenseRatioPct" contextRef="C000016601_ClassMember" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="pure" id="ixv-89364">0.74</ix:nonFraction><span style="font-family:'Fidelity Sans';font-size:11px;color:#000000;font-style:normal;font-weight:normal;">%</span></div>
</td>
<td valign="top" style="width:1%; "><span style="line-height:12px;">&#160;</span><div style="text-align:left;text-align-last:auto;"></div>
