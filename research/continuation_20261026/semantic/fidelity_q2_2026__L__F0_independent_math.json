    "source": "import json,sys,hashlib\nfrom decimal import Decimal,localcontext\nfrom fractions import Fraction\nfrom pathlib import Path\nCODES=('10','15','20','25','30','35','40','45','50','55','60')\nbundle_path=Path(sys.argv[1]);side_path=Path(sys.argv[2]);braw=bundle_path.read_bytes();sraw=side_path.read_bytes()\nb=json.loads(braw,parse_float=Decimal,parse_int=Decimal);side=json.loads(sraw)\nassert side['case_id']=='fidelity_q2_2026__L' and side['stage']=='F0' and side['observed_transport_status']=='completed' and side['generation_requests_attempted']==1\nworkspace=bundle_path.parents[3]\nbundle_refs={(str((workspace/r['path']).resolve()),r['sha256']) for r in b['refs']}\nfor r in side['input_refs']:\n rp=Path(r['path']).resolve();assert (str(rp),r['sha256']) in bundle_refs\n assert hashlib.sha256(rp.read_bytes()).hexdigest()==r['sha256']\ndef frac(f): return {'numerator':str(f.numerator),'denominator':str(f.denominator)}\ndef calc(raw):\n p=json.loads(raw,parse_float=Decimal,parse_int=Decimal);rows=p['sectors'];assert len(rows)==11\n vals={r['sector_code']:r['weight'] for r in rows};assert set(vals)==set(CODES) and len(vals)==11\n assert all(isinstance(w,Decimal) and w.is_finite() and w>=0 for w in vals.values())\n weights=[Fraction(vals[c]) for c in CODES];total=sum(weights);assert total>0\n q=[w/total for w in weights];exact_units=[w*10000 for w in q];units=[u.numerator//u.denominator for u in exact_units];rem=[u-n for u,n in zip(exact_units,units)]\n for i in sorted(range(11),key=lambda i:(-rem[i],i))[:10000-sum(units)]: units[i]+=1\n assert sum(units)==10000 and all(abs(Fraction(n)-u)<1 for n,u in zip(units,exact_units))\n with localcontext() as ctx:\n  ctx.prec=2048\n  total_decimal=str(sum(vals.values(),Decimal(0)))\n return {'parsed':p,'raw_values':vals,'weights':weights,'normalized':q,'units':units,'raw_sum_exact_decimal':total_decimal}\nf=calc(b['raw_final_or_draft_text']);d=calc(b['own_prior_text']);srows={r['sector_code']:r for r in side['rows']};assert side['status']=='finalized' and side['final_total_units']==10000 and side['final_total_percent']=='100.00'\nrows=[]\nfor i,c in enumerate(CODES):\n s=srows[c];baseline=Fraction(b['common_market']['baseline_weights'][c]);u=f['units'][i];percent=f'{u//100}.{u%100:02d}';weight=f'{u//10000}.{u%10000:04d}'\n assert s['final_units']==u and s['final_percent']==percent and Fraction(Decimal(s['final_weight_decimal']))==Fraction(u,10000)\n assert Fraction(int(s['normalized_weight_exact']['numerator']),int(s['normalized_weight_exact']['denominator']))==f['normalized'][i]\n assert Decimal(s['raw_weight_exact_decimal'])==f['raw_values'][c]\n assert Fraction(int(s['normalization_delta_exact']['numerator']),int(s['normalization_delta_exact']['denominator']))==f['normalized'][i]-f['weights'][i]\n assert Fraction(int(s['rounding_delta_exact']['numerator']),int(s['rounding_delta_exact']['denominator']))==Fraction(u,10000)-f['normalized'][i]\n rows.append({'sector_code':c,'raw_weight_exact_decimal':str(f['raw_values'][c]),'own_D0_raw_weight_exact_decimal':str(d['raw_values'][c]),'raw_delta_exact':frac(f['weights'][i]-d['weights'][i]),'normalized_weight_exact':frac(f['normalized'][i]),'final_units':u,'final_percent':percent,'normalization_delta_exact':frac(f['normalized'][i]-f['weights'][i]),'rounding_delta_exact':frac(Fraction(u,10000)-f['normalized'][i]),'own_D0_final_units_independent':d['units'][i],'derived_unit_delta':u-d['units'][i],'raw_active_weight_exact':frac(f['weights'][i]-baseline),'derived_active_weight_exact':frac(Fraction(u,10000)-baseline),'normalized_active_weight_exact':frac(f['normalized'][i]-baseline)})\ndef vol(weights):\n with localcontext() as ctx:\n  ctx.prec=60\n  w=[Decimal(x.numerator)/Decimal(x.denominator) for x in weights];cov=b['common_market']['covariance'];v=sum((w[i]*cov[i][j]*w[j] for i in range(11) for j in range(11)),Decimal(0))*b['common_market']['annualization_trading_days'];return str(v.sqrt())\nresult={'status':'independent_exact_math_mat